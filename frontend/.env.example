# Base URL of the Flixr backend (BFF). Used by both server and client API layers.
#
# IMPORTANT for containerised/self-hosted deploys: NEXT_PUBLIC_* values are
# inlined into the browser bundle at BUILD time, not read at runtime. This URL
# must therefore be reachable from the *visitor's browser* — not an internal
# Docker service name like http://backend:4000, which only resolves inside the
# compose network. Use the LAN address or hostname you'll actually browse to,
# and pass it as a build arg when building the image.
NEXT_PUBLIC_API_URL=http://localhost:4000

# TMDB image CDN base (used to build poster/backdrop URLs).
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
