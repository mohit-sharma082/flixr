# ---------------------------------------------------------------------------
# Frontend environment — LOCAL DEVELOPMENT ONLY.
#
# Under Docker Compose these are set in docker-compose.yml; you don't need this
# file at all. Copy it to .env.local only when running `pnpm dev` by hand.
# ---------------------------------------------------------------------------

# Absolute base URL of the backend, used by SERVER-side code: RSC data fetches,
# generateMetadata, and the /api/* proxy in app/api/[...path]/route.ts. Read at
# request time, so it can differ per deployment without a rebuild. Inside
# Compose this is the service name (http://backend:4000) — an address the
# visitor's browser cannot resolve, which is exactly why it is separate from
# the variable below.
BACKEND_INTERNAL_URL=http://localhost:4000

# Where the BROWSER sends API calls. Leave it unset (the default) and the
# browser uses this same origin: /api/* is proxied to the backend, so there is
# no CORS and no backend hostname inlined into the bundle.
#
# Only set this if you want the browser to bypass the proxy and call the
# backend directly — and note NEXT_PUBLIC_* values are inlined at BUILD time,
# so it must be an address the visitor's browser can reach (not a Docker
# service name), and the backend's CORS_ORIGINS must list this app's origin.
# NEXT_PUBLIC_API_URL=

# TMDB image CDN base (used to build poster/backdrop URLs).
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
