# ---------------------------------------------------------------------------
# Flixr — Docker Compose environment
#
#   cp .env.example .env    then fill in TMDB_API_KEY
#
# Only the values the stack cannot derive on its own live here. Wiring between
# containers (Mongo URI, Redis host, trust-proxy, ports) is set in
# docker-compose.yml, so it stays correct no matter what this file says.
# ---------------------------------------------------------------------------

# REQUIRED. https://www.themoviedb.org/settings/api — the "API Key (v3 auth)".
# The backend refuses to start without it.
TMDB_API_KEY=

# REQUIRED. Signs auth tokens. Min 32 chars, validated at boot.
# Generate with: openssl rand -hex 48
JWT_SECRET=

# How long an issued token stays valid.
JWT_EXPIRES_IN=2d

# Host port the app is published on. Change if 3000 is taken.
FLIXR_PORT=3000

# Extra browser origins allowed to call the API directly. The app itself is
# same-origin (Next proxies /api/*), so this only matters if something else
# calls the backend cross-origin. Comma-separated.
CORS_ORIGINS=http://localhost:3000

# TMDB response cache lifetime, in seconds.
CACHE_TTL_SECONDS=18000

# Global per-IP request budget per minute. Search and auth have tighter caps.
RATE_LIMIT_MAX=200
