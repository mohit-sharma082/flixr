TMDB_API_KEY=
PORT=4000
MONGO_URI=mongodb://localhost:27017/tmdbapp

# Generate a strong value, e.g. `openssl rand -hex 48`. Min 32 chars (validated at boot).
JWT_SECRET=
JWT_EXPIRES_IN=2d

REDIS_HOST=localhost
REDIS_PORT=6379
# Optional; set only if your Redis requires auth.
REDIS_PASSWORD=

# Comma-separated allowlist of browser origins for CORS. Defaults to http://localhost:3000.
CORS_ORIGINS=http://localhost:3000

TMDB_BASE=https://api.themoviedb.org/3
CACHE_TTL_SECONDS=18000

# --- Deployment ---
# Reverse-proxy hops to trust for the client IP (rate limiting is keyed by it).
# 0/unset = the app is exposed directly. 1 = one proxy (nginx/Caddy/Traefik) in front.
# Do NOT set this higher than the number of proxies you actually control — clients
# can forge X-Forwarded-For and evade rate limits.
TRUST_PROXY=0

# Global per-IP request budget per minute (search/auth have their own tighter caps).
RATE_LIMIT_MAX=200
